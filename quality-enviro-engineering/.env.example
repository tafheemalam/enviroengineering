# Copy to backend/.env (or project-root .env) and fill in real values.
APP_ENV=production
APP_DEBUG=false
# Public URL of the website, no trailing slash (used for canonical URLs, sitemap, OG tags)
APP_URL=https://www.your-domain.com
# Long random string: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=
# Origins allowed to call the API cross-origin (only needed for the Vite dev server)
CORS_ORIGINS=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=qes_website
DB_USER=qes_user
DB_PASS=

# Max upload size in bytes (default 5 MB)
UPLOAD_MAX_BYTES=5242880
